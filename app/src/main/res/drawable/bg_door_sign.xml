<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:startColor="#0a0e1a"
                android:centerColor="#0f1a2e"
                android:endColor="#0a1628"
                android:angle="135" />
        </shape>
